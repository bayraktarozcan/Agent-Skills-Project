root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,sh}]
indent_style = space
indent_size = 4

# Windows scripts are CRLF in .gitattributes; the editor must agree.
[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{py,json,toml,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
