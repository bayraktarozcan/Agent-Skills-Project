#!/bin/sh
# Tracked pre-push gate. Install with: python Scripts/install_hooks.py
# Runs the same named checks as the documented local gate.
set -eu

if command -v py >/dev/null 2>&1; then
  # Force the launcher's default interpreter; a bare `py script.py` honors the
  # script's `#!/usr/bin/env python3` shebang, which can resolve to a dead stub.
  PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi

cd "$(git rev-parse --show-toplevel)"

$PY -m py_compile skills.py
$PY skills.py --version >/dev/null
$PY skills.py --list >/dev/null
$PY skills.py --help >/dev/null
$PY skills.py --dry-run >/dev/null
$PY skills.py --dry-run trusted >/dev/null
$PY skills.py --dry-run all >/dev/null
$PY skills.py --dry-run K2 >/dev/null
$PY skills.py --dry-run K2 K4 K6 >/dev/null
$PY skills.py --check --profile temel >/dev/null
$PY skills.py --check --profile tam >/dev/null
$PY Scripts/check_encoding.py --selftest >/dev/null
$PY Scripts/check_encoding.py >/dev/null
$PY Scripts/check_version_parity.py >/dev/null
$PY Scripts/verify_mirror.py AGENTS.md AGENTS-TR.md >/dev/null
$PY Scripts/check_action_refs.py >/dev/null
$PY Scripts/check_repo_conventions.py >/dev/null
$PY Scripts/check_line_endings.py >/dev/null
$PY Scripts/check_gate_parity.py >/dev/null
$PY Scripts/python_floor.py check --offline >/dev/null

echo "pre-push gate: all checks passed"
